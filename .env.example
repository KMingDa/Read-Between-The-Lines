# Application
APP_ENV=development

# PostgreSQL (POSTGRES_PASSWORD is read by infra/docker-compose.yml)
DATABASE_URL=
POSTGRES_PASSWORD=

# Auth: long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
